# Storage. The app picks the first backend whose config is present:
#   1. GCS  – set GCS_BUCKET (Cloud Run authenticates automatically)
#   2. S3   – set S3_BUCKET + AWS credentials
#   3. Local – falls back to LOCAL_STORAGE_DIR on the filesystem

GCS_BUCKET=

LOCAL_STORAGE_DIR=./data

# S3_BUCKET=your-bucket-name
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=ap-south-1